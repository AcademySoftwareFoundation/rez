+            Use(se).validate('x')
+        except SchemaError as e:
+            assert e.autos == [None, 'first auto']
+            assert e.errors == [None, 'first error']
+        try:
+            Use(se, error='second error').validate('x')
+        except SchemaError as e:
+            assert e.autos == [None, 'first auto']
